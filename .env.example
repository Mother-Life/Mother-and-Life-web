# Developpement local : SQLite, sans serveur externe
DATABASE_ADAPTER=sqlite
DATABASE_URI=file:./motherandlife.db

# Production : PostgreSQL / Neon
# DATABASE_ADAPTER=postgres
# DATABASE_URI=postgresql://user:password@host/database?sslmode=require

# Payload (min. 32 caracteres)
PAYLOAD_SECRET=change-me-to-a-long-random-string-min-32-chars

# Premier admin (npm run create-admin)
ADMIN_EMAIL=admin@motherandlife.org
ADMIN_PASSWORD=Admin123!ChangeMe

# Public URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_MEDIA_URL=http://localhost:3000/media

# Cloudflare R2 (S3-compatible) ù production
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@motherandlife.org
RESEND_TO_EMAIL=motherandlife22@gmail.com

# Revalidation webhook secret
REVALIDATE_SECRET=change-me

# Preview
PREVIEW_SECRET=change-me
