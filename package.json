{
  "name": "mother-and-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./node_modules/next/dist/bin/next build",
    "start": "node ./node_modules/next/dist/bin/next start",
    "dev": "node scripts/dev.mjs",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check": "npm run check:encoding && npm run typecheck && npm run lint",
    "payload": "node --env-file=.env ./node_modules/payload/bin.js",
    "migrate": "node --env-file=.env ./node_modules/payload/bin.js migrate",
    "generate:types": "node --env-file=.env ./node_modules/payload/bin.js generate:types",
    "create-admin": "node --env-file=.env --import tsx scripts/create-admin.ts",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "import:medias": "tsx scripts/import-medias.ts",
    "check:medias": "tsx scripts/check-medias.ts",
    "optimize:assets": "tsx scripts/optimize-assets.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "clsx": "^2.1.1",
    "graphql": "^16.10.0",
    "next": "15.4.11",
    "payload": "^3.88.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.1.2",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.4.11",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.0.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 15.4",
    "ios_saf >= 15.4",
    "samsung >= 21",
    "opera >= 95"
  ]
}
